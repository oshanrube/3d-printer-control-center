#!/bin/sh /etc/rc.common
# k2cam: K2 camera keyframe/snapshot service (3d-printer-control-center, tools/k2cam).
# Reads cam_app's H.264 over libdelivery; serves :8080 /keyframe, /?action=snapshot, /status.
START=98
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/k2cam -p 8080 -s 1280x720
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
