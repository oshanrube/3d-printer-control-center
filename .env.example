# Copy to .env on the Pi and fill in. .env is gitignored.

# Cloudflare Tunnel token (from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install).
# Needed for HTTPS + remote access + Web Push.
CLOUDFLARE_TUNNEL_TOKEN=

# Contact used in Web Push (VAPID). A real mailto is recommended by push services.
VAPID_SUBJECT=mailto:you@example.com

# AI failure checks: API key for the llama.cpp vision-model server on bc250.
# Leave empty to keep AI checks off.
AI_API_KEY=
# AI_BASE_URL=http://10.0.68.30:8888
# AI_INTERVAL_SEC=120
# AI_AUTO_PAUSE=0   # 1 = pause the print on a confident, repeated failure verdict
