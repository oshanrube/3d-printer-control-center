# Copy to .env on the Pi and fill in. .env is gitignored.

# Cloudflare Tunnel token (from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install).
# Needed for HTTPS + remote access + Web Push.
CLOUDFLARE_TUNNEL_TOKEN=

# Contact used in Web Push (VAPID). A real mailto is recommended by push services.
VAPID_SUBJECT=mailto:you@example.com

# AI failure detection
# Stage 1: Obico failure detector (ml_api) on the Pi's NPU: `docker compose --profile npu up -d detector`.
# Any random string; the detector container and the app both read it from here.
OBICO_TOKEN=
# OBICO_URL=http://127.0.0.1:3333
# OBICO_IMAGE_BASE=http://127.0.0.1:8081   # how the detector reaches this server
# OBICO_SENSITIVITY=1
# AUTO_PAUSE_FAILURE=0   # 1 = pause the print at the detector's "failure" level
# Stage 2 (optional): vision LLM second opinion (llama.cpp server with a vision projector).
AI_API_KEY=
# AI_BASE_URL=http://10.0.68.30:8888
