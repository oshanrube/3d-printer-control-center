{
  "name": "printforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend engine for the 3D Printer Control Center: connects to Moonraker, detects print failures, pauses prints, and sends web-push alerts.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "puppeteer-core": "^23.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
